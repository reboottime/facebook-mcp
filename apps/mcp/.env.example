# Every variable here is optional: both entries boot with none of them set.

# --- stdio entry (single operator) ---
META_ACCESS_TOKEN=
META_PAGE_ID=

# --- HTTP entry (multi-user remote server) ---
# Meta app credentials. Without them the server still boots and serves OAuth discovery, but the
# "Connect with Facebook" step reports itself unavailable.
FB_APP_ID=
FB_APP_SECRET=

# Canonical public origin. Issuer, redirect URIs, and the token audience are all derived from it,
# so it must match how clients actually reach the server. Defaults to http://localhost:PORT.
PUBLIC_URL=
PORT=
# Bind address. Defaults to 127.0.0.1, which is what you want locally; a container behind a proxy
# (Fly) must set this to 0.0.0.0 or nothing outside the VM can reach it.
HOST=

# Comma-separated browser origins allowed to call /mcp (DNS-rebinding defence). Defaults to
# PUBLIC_URL's origin.
ALLOWED_ORIGINS=

# Neon **direct** (non-pooler) connection string — see docs/fly-deployment.md §4. Unset falls back
# to an in-memory PGlite that migrates itself on boot and is lost on exit.
DATABASE_URL=

# 32 bytes of base64 (openssl rand -base64 32). Encrypts every stored Meta token at rest. Unset
# generates one per process, so stored credentials do not survive a restart.
TOKEN_ENCRYPTION_KEY=

# Meta endpoint overrides. Only the integration harness sets these, to point the login dialog and
# the Graph API at its in-process fake. Leave blank in every real deployment.
FB_DIALOG_BASE_URL=
GRAPH_BASE_URL=
